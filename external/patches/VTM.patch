--- external/VTM/source/Lib/DecoderLib/VideCapture.h	1970-01-01 08:00:00.000000000 +0800
+++ external/VTM/source/Lib/DecoderLib/VideCapture.h	2026-10-13 23:40:00.673108700 +0800
